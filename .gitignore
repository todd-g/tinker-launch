# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tinker Launch credentials
.envrc

# Context and screenshots
.context/
.playwright-mcp/

# Local data, secrets and agent scratch — never publish (public repo)
*.db
*.db-*
credentials.yaml
.claude/tmp/
.claude/worktrees/
.claude/settings.local.json

# Idea research, client docs and prototypes — kept on disk, out of the public repo
/docs/brainstorms/
/aspc-buckle-research/
/courtreserve-research.html
/tinker-launch-build-review.*
/*.png
/scripts/fix-*.cjs

# Bronco demo prototype (and its isolated build output)
/src/app/bronco-demo/
/src/lib/bronco-demo/
/public/bronco-demo/
/scripts/bronco-demo/
/.next-bronco-demo/
